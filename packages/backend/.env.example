PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/techspeak

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# Only this email can ever be granted admin access via
# PATCH /api/admin/users/:id (adminUserService.setUserAdminStatus). Leave
# unset to disable the restriction (any is_admin=true row works, the
# pre-existing behavior).
ADMIN_EMAIL=

# Anthropic (chat/explicacoes com IA)
ANTHROPIC_API_KEY=

# Rate limit: max AI requests per user per day, plan-aware (Dia 49)
AI_DAILY_RATE_LIMIT_FREE=
AI_DAILY_RATE_LIMIT_PRO=

# Rate limit: general per-IP request cap across all /api/* routes, and a
# tighter one for /api/auth/* specifically (login/register spam) (Dia 75)
GENERAL_RATE_LIMIT=
AUTH_RATE_LIMIT=

# Set to "production" to enable HTTPS enforcement (redirects plain HTTP to
# HTTPS) and the Strict-Transport-Security header (Dia 75). Left unset in
# local dev, where the app only ever runs over plain http://localhost.
NODE_ENV=

# ElevenLabs (TTS) - scripts/generateNarration.js. Voice IDs come from
# ElevenLabs' voice library (the id at the end of a voice's URL).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_MALE=

# OpenAI TTS (scripts/generateNarration.js --provider=openai) - a cheaper,
# pay-as-you-go alternative to ElevenLabs, no per-account voice IDs needed
# (fixed 'nova'/'onyx' voices).
OPENAI_API_KEY=

# Base URL scripts/generateNarration.js uses to build each chapter's
# audio_url - defaults to localhost in dev; set to the real backend URL
# once deployed.
BACKEND_PUBLIC_URL=

# Stripe (one-time "TechSpeak Vitalicio" purchase, not a subscription)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used to build the Stripe Checkout success/cancel redirect URLs, and (Dia
# 75) as the origin(s) CORS allows - accepts a comma-separated list (e.g.
# to also allow a LAN address like http://192.168.x.x:5173 for testing the
# web app from a phone on the same Wi-Fi)
FRONTEND_URL=http://localhost:5173

# AWS S3 (audiobook audio storage, POST /api/admin/audiobooks)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
