PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/techspeak

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# Anthropic (chat/explicacoes com IA)
